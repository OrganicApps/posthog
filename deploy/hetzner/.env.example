# Documents every variable deploy.sh / hetzner-deploy.yml consume. No real values here —
# this file is committed to git on purpose so the required inputs are self-documenting.
# Actual values live in GitHub Environment Secrets/Variables on OrganicApps/posthog
# (Environment used by .github/workflows/hetzner-deploy.yml), never in this file.

# --- required ---
DOMAIN=                        # e.g. ph.myorganicapps.com — needs a real DNS A record before first deploy
HETZNER_SERVER_IP=              # the box's public IPv4
HETZNER_ROBOT_USER=             # Hetzner Robot webservice account (Robot > Settings > Webservice), not your login
HETZNER_ROBOT_PASSWORD=

# --- optional, safe to leave blank ---
SENTRY_DSN=                     # real self-hosted/SaaS Sentry DSN — leave blank rather than a fake placeholder
ANTHROPIC_API_KEY=               # enables PostHog's Max assistant, only if you want AI features
OPENAI_API_KEY=                  # enables SQL/regex AI assist

# --- versioning ---
POSTHOG_APP_TAG=latest           # pin to a specific tag/digest for a real production rollout, not floating latest
POSTHOG_NODE_TAG=latest
POSTHOG_REF=hetzner-deploy        # branch/commit of OrganicApps/posthog that deploy.sh checks out

# --- tuning defaults, override only if you know you need to ---
SESSION_RECORDING_RETENTION=30d
DEPLOY_DIR=/opt/posthog-platform

# --- admin access (used by firewall-baseline.sh, run once manually, not by CI) ---
VPN_EGRESS_IP=
