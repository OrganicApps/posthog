# Copy this to /opt/posthog-platform/.env.extra on the SERVER (never commit real
# values — this .example file stays empty on purpose). deploy.sh sources it
# automatically on every run, so anything set here persists across deploys without
# needing to be re-typed/re-passed in the SSH command each time.
#
#   scp .env.extra.example root@<server>:/opt/posthog-platform/.env.extra
#   ssh root@<server> 'chmod 600 /opt/posthog-platform/.env.extra'
#   # then edit it in place with real values
#
# Uses `: "${VAR:=value}"` (not plain VAR=value) so a value explicitly passed to a
# specific deploy.sh invocation still overrides what's stored here.

: "${SENTRY_DSN:=}"
: "${ANTHROPIC_API_KEY:=}"
: "${OPENAI_API_KEY:=}"

: "${SOCIAL_AUTH_GOOGLE_OAUTH2_KEY:=}"
: "${SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET:=}"

# Custom Rust image overrides (see registry/build-and-push.sh)
: "${CAPTURE_IMAGE:=}"
: "${CAPTURE_LOGS_IMAGE:=}"
: "${PROPERTY_DEFS_RS_IMAGE:=}"
: "${FEATURE_FLAGS_IMAGE:=}"
: "${PERSONHOG_REPLICA_IMAGE:=}"
: "${PERSONHOG_ROUTER_IMAGE:=}"
: "${HYPERCACHE_SERVER_IMAGE:=}"
: "${CYCLOTRON_JANITOR_IMAGE:=}"
: "${CYMBAL_IMAGE:=}"
